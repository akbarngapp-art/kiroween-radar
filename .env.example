# Radar environment variables
# Copy to .env and fill in real values. Never commit .env to source control.

# GitHub personal access token (optional — raises API rate limit for release corroboration)
GITHUB_TOKEN=

# Set to 1 to activate the kill switch and halt all outbound network activity
RADAR_KILL=

# Tuning knobs (all optional — defaults are shown)
# FETCH_TIMEOUT_MS=10000
# FETCH_BACKOFF_MS=2000
# POLL_INTERVAL_MS=300000
# COOLDOWN_WINDOW_MS=3600000
# STALENESS_THRESHOLD_MS=3600000
